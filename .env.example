# Cloud project configuration. Use the matching publishable key for this project.
NEXT_PUBLIC_SUPABASE_URL=https://isgoypmebtoipfvtaflg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service_role key for audited Supabase Auth Admin operations.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
APP_BASE_URL=https://your-deployment-domain.example
INITIAL_SUPER_ADMIN_BOOTSTRAP_TOKEN=
OWNER_SUPER_ADMIN_EMAIL=

# Canonical scheduled workflow automation secret (>= 16 characters).
# Used by /api/automation/run via Authorization: Bearer <CRON_SECRET> or x-automation-secret.
# Legacy aliases supported in descending precedence:
#   1. CRON_SECRET (canonical)
#   2. WORKFLOW_AUTOMATION_SECRET (legacy alias)
#   3. AUTOMATION_CRON_SECRET (legacy alias)
CRON_SECRET=

# Canonical transactional email configuration for serverless notifications.
# Sender address precedence:
#   1. TRANSACTIONAL_EMAIL_FROM (canonical, e.g. "TheCodexThrill <notifications@yourdomain.com>")
#   2. EMAIL_FROM (legacy alias)
TRANSACTIONAL_EMAIL_FROM=

# Configure one serverless provider below (Resend HTTP API takes precedence over webhook):
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_WEBHOOK_URL=

# Note: Direct SMTP environment variables (SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS)
# are NOT read by serverless functions. Custom Auth SMTP is configured inside the
# Supabase Cloud Dashboard (Authentication -> Emails -> SMTP Settings).
# Set SUPABASE_CUSTOM_SMTP_CONFIGURED=true once verified in Supabase Cloud Dashboard.
SUPABASE_CUSTOM_SMTP_CONFIGURED=

# Optional Web Push VAPID keys (both required if Web Push is enabled):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
