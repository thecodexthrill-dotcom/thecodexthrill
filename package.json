{
  "name": "thecodexthrill",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/run-next-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:bootstrap": "node --experimental-strip-types --test src/lib/supabase/bootstrap-token.test.ts",
    "test:cms": "node --experimental-strip-types --test src/lib/supabase/cms-foundation.test.ts",
    "test:ops": "node --experimental-strip-types --test src/lib/supabase/operations-foundation.test.ts src/lib/supabase/delivery-operations.test.ts",
    "test:crm": "node --experimental-strip-types --test src/lib/supabase/lead-conversion-funnel.test.ts",
    "test:auth": "node --experimental-strip-types --test src/lib/supabase/bootstrap-token.test.ts src/lib/supabase/auth-link-status.test.ts src/lib/supabase/invitation-link.test.ts src/lib/supabase/invitation-email-status.test.ts src/lib/supabase/auth-flow.test.ts src/lib/supabase/platform-invitations.test.ts src/lib/supabase/platform-role-management.test.ts src/lib/supabase/invitation-handoff.test.ts src/lib/supabase/invitation-list-regression.test.ts src/lib/supabase/invitation-lifecycle-regression.test.ts",
    "test": "npm run test:auth && npm run test:cms && npm run test:ops && npm run test:crm",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,mjs,ts}\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "supabase": "^2.118.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
